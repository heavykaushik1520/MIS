	public List<BrandResponseDTO> getAllBrands() {
	    List<Brand> brands = brandRepository.findAll()
	        .stream()
	        .filter(Brand::isActive) // Only return active brands
	        .collect(Collectors.toList());

	    return brands.stream().map(brand -> {
	        BrandResponseDTO dto = new BrandResponseDTO();
	        dto.setBrandId(brand.getBrandId());
	        dto.setBrandName(brand.getBrandName());
	        return dto;
	    }).collect(Collectors.toList());
	}



	public ResponseEntity<?> getBrandById(int brandId) {
	    Optional<Brand> brandOpt = brandRepository.findById(brandId);
	    
	    if (brandOpt.isEmpty()) {
	        responseWrapper.setMessage("Brand not found!");
	        responseWrapper.setData(null);
	        return ResponseEntity.badRequest().body(responseWrapper);
	    }

	    BrandDTO brandDTO = new BrandDTO(brandOpt.get());

	    responseWrapper.setMessage("Brand details retrieved!");
	    responseWrapper.setData(brandDTO);
	    return ResponseEntity.ok(responseWrapper);
	}


}
