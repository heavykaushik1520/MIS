package com.mis.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.bind.annotation.RequestBody;

import com.mis.entity.Chain;
import com.mis.services.ChainService;

import jakarta.validation.Valid;

@Controller
public class ChainController {

	@Autowired
	ChainService chainService;
	
	@PostMapping("/admin/create")
    public ResponseEntity<?> addChain(@RequestBody @Valid Chain chain) {
        return chainService.addChain(chain);
    }

    @PutMapping("/admin/update/{id}")
    public ResponseEntity<?> updateChain(@PathVariable int id, @RequestBody Chain chain) {
        return chainService.updateChain(id, chain);
    }

    @DeleteMapping("/admin/delete/{id}")
    public ResponseEntity<?> deleteChain(@PathVariable int id) {
        return chainService.deleteChain(id);
    }

    @GetMapping("/all")
    public List<Chain> getAllChains() {
        return chainService.getAllChains();
    }

    @GetMapping("/{id}")
    public ResponseEntity<?> getChainById(@PathVariable int id) {
        return chainService.getChainById(id);
    }
}
