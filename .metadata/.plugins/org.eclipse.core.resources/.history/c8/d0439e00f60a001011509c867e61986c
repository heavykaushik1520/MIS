package com.mis.services;

import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;

import com.mis.entity.*;
import com.mis.repository.BrandRepository;
import com.mis.repository.ChainRepository;
import com.mis.responsewrapper.ResponseWrapper;

@Service
public class BrandService {

	@Autowired
	private BrandRepository brandRepository;
	
	@Autowired
	private ChainRepository chainRepository;
	
	@Autowired
	private ResponseWrapper responseWrapper;
	
	public ResponseEntity<?> addBrand(int chainId , Brand brand){
		Optional<Chain> chainOpt = chainRepository.findById(chainId);
        if (chainOpt.isEmpty()) {
            responseWrapper.setMessage("Chain not found!");
            responseWrapper.setData(null);
            return ResponseEntity.badRequest().body(responseWrapper);
        }
        
        brand.setChain(chainOpt.get());
        Brand savedBrand = brandRepository.save(brand);
        
        responseWrapper.setMessage("Brand added successfully");
        responseWrapper.setData(savedBrand);
        return ResponseEntity.ok(responseWrapper);
	}
	
	public ResponseEntity<?> updateBrand(int brandId , Brand updatedBrand){
		Optional<Brand> brandOpt = brandRepository.findById(brandId);
		if (brandOpt.isEmpty()) {
            responseWrapper.setMessage("Brand not found!");
            responseWrapper.setData(null);
            return ResponseEntity.badRequest().body(responseWrapper);
        }
		
		Brand brand = brandOpt.get();
		brand.setBrandName(updatedBrand.getBrandName());
        brand.setActive(updatedBrand.isActive());
        brand.setUpdatedAt(updatedBrand.getUpdatedAt());
        
        Brand savedBrand = brandRepository.save(brand);
        responseWrapper.setMessage("Brand updated successfully!");
        responseWrapper.setData(savedBrand);
        return ResponseEntity.ok(responseWrapper);
	}
}
